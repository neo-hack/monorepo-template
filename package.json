{
  "name": "@aiou/monorepo-template",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.2",
  "description": "monorepo template",
  "keywords": [
    "monorepo",
    "template",
    "neo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/neo-hack/monorepo-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neo-hack/monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/neo-hack/monorepo-template/issues"
  },
  "author": {
    "name": "jiangweixian"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm build -r",
    "ci:version": "pnpm changeset version",
    "ci:publish": "pnpm run build && pnpm changeset publish",
    "ci:snapshot": "pnpm changeset version --snapshot snapshot",
    "ci:prerelease": "pnpm run build && pnpm changeset publish --no-git-tag --snapshot",
    "prepare": "husky install",
    "test": "pnpm vitest -r"
  },
  "lint-staged": {
    "**/**/*.{js,ts,tsx,json,yml,yaml,md}": ["eslint --fix"]
  },
  "devDependencies": {
    "@aiou/eslint-config": "^1.2.1",
    "@aiou/remark-config": "0.2.0",
    "@changesets/cli": "^2.26.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^18",
    "cz-emoji": "^1.3.1",
    "eslint": "^8.56.0",
    "fs-extra": "^10.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "remark": "^15.0.1",
    "remark-cli": "^11.0.0",
    "typescript": "5.7.3"
  }
}
